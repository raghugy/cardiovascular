# ==========================================
# CardioPredict Environment Configuration
# ==========================================

# Flask Security & JWT Keys
FLASK_SECRET_KEY=your-secure-flask-secret-key-here
JWT_SECRET_KEY=your-secure-jwt-secret-key-here

# Server Port & Upload Configuration
PORT=8000
UPLOAD_FOLDER=uploads/medical_reports
MAX_CONTENT_LENGTH=10485760

# ==========================================
# AI Food & Nutrition Recommendation Service
# ==========================================
# Configure ONE of the following AI providers to enable real-time,
# clinical cardiovascular diet and nutrition recommendations.
#
# Option A: Google Gemini (Recommended - Free Tier Available)
# Obtain your key from: https://aistudio.google.com/app/apikey
# Uses supported SDK: google-genai (Model: gemini-2.5-flash / gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI
# Obtain your key from: https://platform.openai.com/api-keys
# Uses supported SDK: openai (Model: gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
